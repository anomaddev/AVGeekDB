# Supabase (placeholders - never commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only (key verification, usage logging, storage upload)
SUPABASE_STORAGE_BUCKET=downloads
# Pepper mixed into API key hashes (random 32+ bytes)
API_KEY_PEPPER=change-me
# Rate limit per API key
RATE_LIMIT_PER_MINUTE=60
# When unset/"true", the API serves bundled sample data and accepts the demo key below (dev only)
AVGEEKDB_MOCK=true
# Cloudflare Turnstile (signup + submission forms) - placeholders
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
