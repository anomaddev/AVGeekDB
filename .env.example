# Supabase (placeholders - never commit real values)
# Local CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Prefer a publishable key (sb_publishable_...). If unset, the legacy anon key is used.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser. Legacy service_role JWT or sb_secret_... key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # key verification, usage logging, storage upload
SUPABASE_STORAGE_BUCKET=downloads
# Pepper mixed into API key hashes (random 32+ bytes)
API_KEY_PEPPER=change-me
# Rate limit per API key
RATE_LIMIT_PER_MINUTE=60
# When unset/"true", the API serves bundled sample data and accepts the demo key below (dev only)
AVGEEKDB_MOCK=true
# Cloudflare Turnstile (signup + submission forms) - placeholders
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
