{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "airports", "title": "Airport (placeholder schema)", "type": "object",
  "required": ["ident", "name", "country", "latitude", "longitude", "type", "is_sample"],
  "properties": {
    "ident": {"type": "string", "minLength": 1}, "iata": {"type": ["string","null"], "pattern": "^[A-Z0-9]{3}$"},
    "icao": {"type": ["string","null"], "pattern": "^[A-Z0-9]{4}$"}, "name": {"type": "string"}, "city": {"type": ["string","null"]},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "elevation_ft": {"type": ["integer","null"]},
    "type": {"enum": ["large_airport","medium_airport","small_airport","heliport","seaplane_base","closed"]}, "is_sample": {"type": "boolean"} },
  "additionalProperties": false }
