{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "airports", "title": "Airport (OurAirports layout)", "type": "object",
  "required": ["ident", "name", "country", "latitude", "longitude", "type", "scheduled_service", "is_sample"],
  "properties": {
    "ident": {"type": "string", "minLength": 1}, "iata": {"type": ["string","null"], "maxLength": 3},
    "icao": {"type": ["string","null"], "maxLength": 4}, "name": {"type": "string"}, "municipality": {"type": ["string","null"]},
    "country": {"type": "string", "pattern": "^[A-Z0-9]{2}$", "description": "ISO 3166-1 alpha-2 (OurAirports iso_country; XK = Kosovo)"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "elevation_ft": {"type": ["integer","null"]},
    "type": {"enum": ["large_airport","medium_airport","small_airport","heliport","seaplane_base","balloonport","closed"]},
    "continent": {"enum": ["AF","AN","AS","EU","NA","OC","SA",null]}, "iso_region": {"type": ["string","null"]},
    "scheduled_service": {"type": "boolean"}, "gps_code": {"type": ["string","null"]}, "local_code": {"type": ["string","null"]},
    "home_link": {"type": ["string","null"]}, "wikipedia_link": {"type": ["string","null"]}, "keywords": {"type": ["string","null"]},
    "is_sample": {"type": "boolean"} },
  "additionalProperties": false }
