{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "aircraft_types", "title": "Aircraft type", "type": "object",
  "required": ["ident", "name", "alternate_names", "in_production", "major", "cargo", "military", "is_primary", "is_sample"],
  "properties": {
    "ident": {"type": "string", "minLength": 1}, "icao": {"type": ["string","null"], "pattern": "^[A-Z0-9]{2,4}$"}, "iata": {"type": ["string","null"]},
    "family": {"type": ["string","null"]}, "name": {"type": "string"}, "short_name": {"type": ["string","null"]},
    "alternate_names": {"type": "array", "items": {"type": "string"}}, "manufacturer": {"type": ["string","null"]},
    "engine_count": {"type": ["integer","null"], "minimum": 0},
    "engine_type": {"enum": ["Piston","Turbofan","Turbojet","Turboprop","Turboshaft","Electric",null]},
    "aircraft_type": {"enum": ["jet_aircraft","turboprop_aircraft","piston_aircraft","helicopter","amphibious",null]},
    "in_production": {"type": "boolean"},
    "status": {"enum": ["Operational","Retired","Limited","Prototype","Certification","Conceptual",null]},
    "major": {"type": "boolean"}, "cargo": {"type": "boolean"}, "military": {"type": "boolean"},
    "wiki_link": {"type": ["string","null"]}, "is_primary": {"type": "boolean"}, "wake_category": {"enum": ["L","M","H","J",null]},
    "is_sample": {"type": "boolean"} },
  "additionalProperties": false }
